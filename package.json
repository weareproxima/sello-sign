{
	"name": "sello-sign",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "prettier --write . && gofmt -w apps/api",
		"format:check": "prettier --check . && test -z \"$(gofmt -l apps/api)\""
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"turbo": "^2.9.18"
	}
}
