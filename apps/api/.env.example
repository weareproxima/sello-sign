# The API reads its environment and, for what isn't set there, this file
# copied to apps/api/.env (`go run ./cmd/api` from apps/api).

# Where it listens.
ADDR=127.0.0.1:4441

# Postgres and Valkey of compose.yml (`podman compose up -d` at the root).
DATABASE_URL=postgres://sign:sign@127.0.0.1:5434/sign
REDIS_URL=redis://127.0.0.1:6381/0

# 32 bytes in base64 (`openssl rand -base64 32`): AES-256-GCM for the
# certificates' material. Optionally versioned, "v2:…"; while rotating, the
# old one goes in SIGN_SECRETS_KEY_PREVIOUS. Losing it loses every
# certificate.
SIGN_SECRETS_KEY=
SIGN_SECRETS_KEY_PREVIOUS=

# The panel: the issuer of its tokens and its JWKS (<PANEL_URL>/api/auth/jwks),
# and the audience the tokens are for (the defaults). They must match the panel's
# BETTER_AUTH_URL and API_URL byte for byte.
PANEL_URL=http://127.0.0.1:4440
API_URL=http://127.0.0.1:4441
# Other origins that may call the API from a browser, comma-separated.
CORS_ORIGINS=

# The countries offered (default SV,DO,CR,PA,GT).
SIGN_COUNTRIES=SV,DO,CR,PA,GT

# The limits of the spaces without a plan (a self-hosted install's; in the
# cloud, billing pushes each space's plan): the signatures a minute of each
# space, and the days the signing log keeps an entry. Empty is none; the
# console sets other limits per space (`api workspace limits`).
SIGN_RATE_LIMIT_PER_MINUTE=
SIGN_LOG_RETENTION_DAYS=

# Sello's cloud (sign.sello.tax).
CLOUD=false
SIGN_PLATFORM_WORKSPACE_ID=
BILLING_URL=
BILLING_TOKEN=
BILLING_PUSH_TOKEN=

# The notices the API e-mails every hour to who administers each space
# (certificates about to expire, the plan's usage): through Resend with
# RESEND_API_KEY, from EMAIL_FROM (default `Sello Sign <noreply@sign.sello.tax>`,
# an address of a domain verified in Resend); without the key, they're
# written to the log. The same variables as the panel's.
RESEND_API_KEY=
EMAIL_FROM=

# json (default) or text; debug, info, warn, error.
LOG_FORMAT=text
LOG_LEVEL=info
