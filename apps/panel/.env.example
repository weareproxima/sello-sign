# The panel (TanStack Start + better-auth), in 127.0.0.1:4440.
# Copy to .env and fill BETTER_AUTH_SECRET (`openssl rand -base64 32`).

# The database `sign` of compose.yml; better-auth's tables live in its `auth`
# schema (`bun run db:migrate`), never in `public`, which is the API's.
DATABASE_URL=postgres://sign:sign@127.0.0.1:5434/sign
BETTER_AUTH_SECRET=
# The panel's own origin: the `iss` of the tokens for the API (= the API's PANEL_URL).
BETTER_AUTH_URL=http://127.0.0.1:4440
# The API's origin: the `aud` of those tokens (= the API's API_URL), and where
# the panel forwards /api/sign/*.
API_URL=http://127.0.0.1:4441

# `true` in sign.sello.tax: spaces are Sello's organizations.
CLOUD=false

# An external OpenID Connect provider (in the cloud, Sello's IdP:
# OIDC_ISSUER=https://account.sello.tax, OIDC_ONLY=true).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Hide email and password: the provider is the only way in.
OIDC_ONLY=false
# Optional: the provider's id (default `oidc`; `sello` with CLOUD=true) and the
# name on its button (default `SSO`; `Sello` with CLOUD=true).
OIDC_PROVIDER_ID=
OIDC_PROVIDER_NAME=

# The panel's e-mail (the password reset, the invitations, the sales inquiry),
# through Resend. Without RESEND_API_KEY it goes to the server's console. In
# the cloud EMAIL_FROM is an address of @sign.sello.tax, verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Sello Sign <noreply@sign.sello.tax>
