{
	"name": "panel",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 4440 --host 127.0.0.1",
		"build": "vite build",
		"build:cloudflare": "NITRO_PRESET=cloudflare_module vite build",
		"preview": "vite preview",
		"start": "node .output/server/index.mjs",
		"preview:cloudflare": "wrangler dev --port 4442 --ip 127.0.0.1",
		"deploy": "bun run build:cloudflare && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate": "bun run scripts/migrate.ts",
		"lint:design": "bun scripts/lint-design.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "5.108.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.7",
		"better-auth": "1.7.6",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"kysely": "0.29.9",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"pg": "8.23.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"@types/pg": "^8.15.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.0.0",
		"wrangler": "4.139.0"
	}
}
